# For a Brev NIM exposed on host port 8001 and container port 8000, use:
NEMOTRON_VISION_ENDPOINT=http://127.0.0.1:8001/v1
NEMOTRON_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
# Required before a Pi can submit camera frames.
SHIFTLENS_INGEST_TOKEN=replace-with-a-long-random-token
# Optional separate text reasoning endpoint; leave unset to use local evidence-only fallback.
# NEMOTRON_ENDPOINT=http://127.0.0.1:8002/v1
# NEMOTRON_MODEL=nvidia/nemotron-3-nano
# Optional if your NIM endpoint requires a bearer token. Never commit the value.
# NEMOTRON_API_KEY=
