# Replace with the Mac's LAN/hotspot IP. Start the Mac API bound to 0.0.0.0.
SHIFTLENS_API_URL=http://192.168.1.10:8000
SHIFTLENS_INGEST_TOKEN=replace-with-the-same-long-random-token-as-the-Mac
SHIFTLENS_WORKER=Worker 01
SHIFTLENS_AREA=Workshop
SHIFTLENS_DEVICE_ID=shiftlens-pi-01
# Use "usb" for a UVC webcam, or "limelight" for a Limelight 3A on the same LAN.
SHIFTLENS_CAMERA_SOURCE=usb
SHIFTLENS_CAMERA_INDEX=0
# Set this to the device host/IP (without a port) for Limelight mode.
SHIFTLENS_LIMELIGHT_URL=http://limelight.local
# Optional mapping from AprilTag ID to a human-readable work area.
SHIFTLENS_LIMELIGHT_TAG_MAP={"1":"Pump Bay A","2":"Pump Bay B"}
SHIFTLENS_SAMPLE_EVERY_SECONDS=1
SHIFTLENS_ANALYZE_EVERY_SECONDS=15
SHIFTLENS_FRAME_WIDTH=640
